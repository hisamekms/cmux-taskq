#!/bin/sh
# Launcher used by the claude-taskq plugin skills.
#
# Resolves the cmux-taskq binary (CMUX_TASKQ_BIN, then PATH) and runs it from
# the current directory, so the binary picks the queue of the repository that
# contains it ($XDG_DATA_HOME/cmux-taskq/<hash>/queue.db). CMUX_TASKQ_DB, when
# set, is passed as `--db` to use another queue file. The launcher never opens
# the database itself.
#
#   taskq --resolve        print the binary, its version and `locate`'s queue fields as one JSON object
#   taskq --version|--help pass through to the binary
#   taskq <command> ...    any cmux-taskq command, including init and locate
set -eu

json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

fail() {
  printf '{"error": "%s"}\n' "$(json_string "$1")" >&2
  exit 1
}

resolve_binary() {
  if [ -n "${CMUX_TASKQ_BIN:-}" ]; then
    [ -x "$CMUX_TASKQ_BIN" ] || fail "CMUX_TASKQ_BIN is not an executable file: $CMUX_TASKQ_BIN"
    printf '%s\n' "$CMUX_TASKQ_BIN"
  elif command -v cmux-taskq >/dev/null 2>&1; then
    command -v cmux-taskq
  else
    fail "cmux-taskq was not found on PATH and CMUX_TASKQ_BIN is unset. Build it in the cmux-taskq repository with 'cargo build --locked', then put target/debug/cmux-taskq on PATH or export CMUX_TASKQ_BIN=/absolute/path/to/cmux-taskq"
  fi
}

binary=$(resolve_binary)

case "${1:-}" in
  --version | -V | --help | -h)
    exec "$binary" "$@"
    ;;
  --resolve)
    version=$("$binary" --version)
    if [ -n "${CMUX_TASKQ_DB:-}" ]; then
      queue=$("$binary" --db "$CMUX_TASKQ_DB" locate)
    else
      queue=$("$binary" locate)
    fi
    repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
    # `locate` prints a pretty JSON object; splice our fields in after its `{`.
    printf '{"binary": "%s", "version": "%s", "repo": "%s",%s\n' \
      "$(json_string "$binary")" "$(json_string "$version")" "$(json_string "$repo")" \
      "${queue#\{}"
    exit 0
    ;;
esac

if [ -n "${CMUX_TASKQ_DB:-}" ]; then
  exec "$binary" --db "$CMUX_TASKQ_DB" "$@"
fi
exec "$binary" "$@"
